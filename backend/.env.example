# Copy this file to .env and fill in the values.

# PostgreSQL started by docker-compose.yml (in the project root)
DATABASE_URL="postgresql://claims:claims@localhost:5432/claims"

# LLM settings: we use the official OpenAI SDK.
# Option A (free): Google Gemini via its OpenAI-compatible endpoint.
#   Key from https://aistudio.google.com/apikey
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_MODEL="gemini-3.8-flash"

# Option B (paid): OpenAI directly: key from https://platform.openai.com/api-keys
#   Leave OPENAI_BASE_URL empty and set e.g. OPENAI_MODEL="gpt-5-mini"

PORT=3000
# Allowed origin for the React app (Vite dev server)
CORS_ORIGIN="http://localhost:5173"
