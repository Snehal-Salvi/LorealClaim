  <diagram id="checks" name="3. How the AI Checks a Claim">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="How the AI Checks a Claim" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="We don&#39;t ask the AI just &quot;yes or no&quot;. We split the claim into small checks." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="claim" value="&lt;b&gt;Efficacy claim&lt;/b&gt;&lt;br&gt;“Reduces wrinkles by 20% in 4 weeks”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gchk" value="5 small checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#9673a6;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="360" y="95" width="380" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c0" value="&lt;b&gt;RIGHT PROOF&lt;/b&gt;: does the evidence type match the claim type?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="125" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;WHAT&lt;/b&gt;: was wrinkle reduction the measured endpoint?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="183" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;HOW MUCH&lt;/b&gt;: did the result reach ≥ 20%?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="241" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;HOW LONG&lt;/b&gt;: did the study run ≥ 4 weeks?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="299" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;HOW RELIABLE&lt;/b&gt;: enough people, placebo group, statistically significant?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="357" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="verdict" value="&lt;b&gt;Justified&lt;/b&gt; = all checks passed&lt;br&gt;&lt;b&gt;Confidence&lt;/b&gt; = passed ÷ checks that apply&lt;br&gt;&lt;b&gt;Reasoning&lt;/b&gt; = why each check passed or failed&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: 18% instead of 20% → 4 of 5 pass&lt;br&gt;→ Justified: No · Confidence: 80%&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="195" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="claim" target="gchk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="gchk" target="verdict">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="data" name="4. Data Model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Data Model (Prisma / PostgreSQL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="claim" value="&lt;b&gt;Claim&lt;/b&gt;&lt;hr&gt;id &amp;nbsp;UUID &amp;nbsp;PK&lt;br&gt;productName &amp;nbsp;String&lt;br&gt;claimType &amp;nbsp;ClaimType&lt;br&gt;claimText &amp;nbsp;String&lt;br&gt;status &amp;nbsp;ClaimStatus&lt;br&gt;createdAt &amp;nbsp;DateTime&lt;br&gt;updatedAt &amp;nbsp;DateTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="260" height="175" as="geometry" />
        </mxCell>
        <mxCell id="assess" value="&lt;b&gt;Assessment&lt;/b&gt;&lt;hr&gt;id &amp;nbsp;UUID &amp;nbsp;PK&lt;br&gt;claimId &amp;nbsp;UUID &amp;nbsp;FK → Claim&lt;br&gt;evidence &amp;nbsp;Text&lt;br&gt;justified &amp;nbsp;Boolean&lt;br&gt;confidence &amp;nbsp;Float (0–1)&lt;br&gt;reasoning &amp;nbsp;Text&lt;br&gt;criteria &amp;nbsp;Json&lt;br&gt;model &amp;nbsp;String&lt;br&gt;promptVersion &amp;nbsp;String&lt;br&gt;createdAt &amp;nbsp;DateTime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="rel" value="1 claim → many assessments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1.5;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;exitX=1;exitY=0.2;entryX=0;entryY=0.1458;" edge="1" parent="1" source="claim" target="assess">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="enum" value="&lt;b&gt;enum ClaimStatus&lt;/b&gt;&lt;hr&gt;PROPOSED · APPROVED · REJECTED&lt;br&gt;IN_TESTING · EVIDENCE_SUBMITTED&lt;br&gt;ASSESSED · VALIDATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="enum2" value="&lt;b&gt;enum ClaimType&lt;/b&gt;&lt;hr&gt;EFFICACY · CONSUMER_PERCEPTION&lt;br&gt;SENSORY · SAFETY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="430" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Why 1 : N?&lt;/b&gt;&lt;br&gt;A claim can be re-assessed with new evidence or a newer model. Keeping every assessment gives a full audit trail." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="280" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="arch" name="5. Deep Dive: Backend">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Deep Dive: How the Backend Works Inside" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
